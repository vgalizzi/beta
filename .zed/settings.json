{
  "languages": {
    "Python": {
      "language_servers": ["basedpyright", "ruff"],
      "format_on_save": "on",
      "formatter": [
        { "language_server": { "name": "ruff" } }
      ],
      "code_actions_on_format": {
        // trie et nettoie les imports à chaque sauvegarde
        "source.organizeImports.ruff": true
      }
    }
  },
  "terminal": {
    "detect_venv": { "on": { "directories": [".venv"] } }
  }
}
